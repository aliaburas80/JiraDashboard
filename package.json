{
  "name": "jiradashboard",
  "version": "2.0.0",
  "description": "Delivery Clarity — Jira Delivery Intelligence Platform",
  "private": true,
  "engines": {
    "node": ">=20.9 <21",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "node scripts/start-server.js dev",
    "build": "prisma generate && next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint . --max-warnings=8",
    "lint:css": "stylelint 'src/**/*.scss' 'app/**/*.scss' --max-warnings=0",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "jest --passWithNoTests",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "validate": "prisma validate && prisma generate && npm run typecheck && npm run lint:css",
    "check:fast": "npm run typecheck && npm run lint:css && npm run test",
    "check:ci": "npm run validate && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@azure/storage-blob": "^12.32.0",
    "@dagrejs/dagre": "^3.0.0",
    "@google-cloud/storage": "^7.19.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "iron-session": "^8.0.4",
    "next": "14.2.35",
    "nodemailer": "^8.0.10",
    "postcss-value-parser": "^4.2.0",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "eslint-plugin-local-rules": "^3.0.2",
    "jest": "^29.7.0",
    "postcss": "^8.4.39",
    "sass": "^1.77.8",
    "stylelint": "^17.13.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^3.4.4",
    "ts-jest": "^29.2.2",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
