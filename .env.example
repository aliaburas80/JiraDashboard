# Delivery Clarity — environment variables
# Copy to .env.local for local development

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── F3: Authentication (required after running: npm install iron-session prisma @prisma/client bcryptjs) ──
# Session encryption key — must be at least 32 characters, keep secret
SESSION_SECRET=change-this-to-a-random-32-char-secret-value

# Session duration in hours (default: 8)
SESSION_TTL_HOURS=8

# SQLite database file path (relative to project root)
DATABASE_URL=file:./data/delivery_clarity.db

# Allow public self-registration (false = admin creates users only).
# Both vars must match: ALLOW_OPEN_REGISTRATION gates the API; NEXT_PUBLIC_ALLOW_REGISTER controls the UI.
ALLOW_OPEN_REGISTRATION=true
NEXT_PUBLIC_ALLOW_REGISTER=true

# First admin account — used by the seed script (prisma/seed.ts)
ADMIN_EMAIL=admin@deliveryclarity.com
ADMIN_PASSWORD="Admin@DC2025"
ADMIN_NAME=Administrator

# ── Email (nodemailer) — optional; leave blank to skip email sending ──
# SMTP credentials for sending welcome emails to new users.
# If any of SMTP_HOST / SMTP_USER / SMTP_PASS is empty, emails are silently skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aburasali80@gmail.com
SMTP_PASS=jjyyyxwbsmwsipcp
SMTP_FROM=JiraDashboard <aburasali80@gmail.com>
