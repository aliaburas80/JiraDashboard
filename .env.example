# Delivery Clarity — environment variables
# Copy to .env for local development, .env.production for production

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of the app — used in email login links and redirects.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Authentication (required) ─────────────────────────────────────────────────
# User-application session encryption key — must be ≥32 chars, keep secret.
SESSION_SECRET=change-this-to-a-random-32-char-secret-value

# User-session duration in hours (default: 8)
SESSION_TTL_HOURS=8

# ── Separate Admin Application (EP-022 / EP-023) ──────────────────────────────
# Admin console runs as its own Next.js process (local default: port 3001).
# Production should assign a dedicated host such as an admin subdomain.
ADMIN_APP_URL=http://localhost:3001

# MUST be different from SESSION_SECRET. The admin app uses a separate
# dc_admin_session cookie and refuses to start in production without this key.
ADMIN_SESSION_SECRET=change-this-to-a-different-random-32-char-admin-secret

# Admin sessions are intentionally shorter than user sessions (default: 4h).
ADMIN_SESSION_TTL_HOURS=4

# Owner Admin bootstrap. Run `npm run owner:admin:bootstrap` explicitly after
# setting these values. The command refuses to create a second Owner Admin.
OWNER_ADMIN_EMAIL=owner@deliveryclarity.com
OWNER_ADMIN_NAME=Owner Administrator
OWNER_ADMIN_PASSWORD=

# Safety switches: both default to false. Promotion is required only when the
# bootstrap email already belongs to a normal account. Rotation changes the
# existing Owner Admin password only when explicitly enabled.
OWNER_ADMIN_PROMOTE_EXISTING=false
OWNER_ADMIN_ROTATE_PASSWORD=false

# Emergency MFA recovery: set OWNER_ADMIN_EMAIL and run
# `npm run owner:admin:reset-mfa`. The next admin-console sign-in must enroll
# MFA again. Rotate ADMIN_SESSION_SECRET too if active admin sessions must be
# invalidated immediately.

# PostgreSQL connection string. Production should use Neon's pooled URL.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/delivery_clarity?sslmode=require

# Allow public self-registration (false = admin creates users only)
ALLOW_OPEN_REGISTRATION=true
NEXT_PUBLIC_ALLOW_REGISTER=true

# Legacy seed admin account — used by the database seed script for development/E2E.
# This is NOT the production Owner Admin bootstrap.
ADMIN_EMAIL=admin@deliveryclarity.com
ADMIN_PASSWORD="Admin@DC2025"
ADMIN_NAME=Administrator

# ── Encrypted App Config ──────────────────────────────────────────────────────
# AES-256-GCM key for encrypting app-config.json and the Admin MFA TOTP secret.
# Must be ≥32 chars. Generate with: openssl rand -hex 32
# Once set, SMTP and other settings can be managed via Admin Settings → App Config.
CONFIG_ENCRYPTION_KEY=change-this-to-a-random-32-char-key-value

# ── Persistent object storage ─────────────────────────────────────────────────
# Local development may use temporary. Hosted production must use object
# storage because application-local files are ephemeral.
STORAGE_DRIVER=temporary
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_PREFIX=delivery-clarity
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Upload cap for Jira CSV/XLS/XLSX files. Keep small for free/small instances.
MAX_UPLOAD_MB=20

# ── Jira API Integration (ARCH-05 — read-only, env fallback) ──────────────────
# Preferred: set the token via Admin Settings → App Config → "Jira API Token"
# (encrypted into the same app-config.json as SMTP, see CONFIG_ENCRYPTION_KEY
# above). This env var is only a fallback/override for when no cloud config
# exists yet, or to force-rotate a token without touching the cloud copy —
# same pattern as SMTP_* below. Shared by every configured JiraConnection
# (single global credential; the connection's base URL/email/deployment type
# are admin-configured in-app, not env vars). See
# product/JIRA_INTEGRATION_DESIGN.md.
# Cloud: an Atlassian API token (paired with the connection's authEmail).
# Server/Data Center: a Personal Access Token (PAT), used as a Bearer token.
GATEWAY_JIRA_API_TOKEN=

# ── Email / SMTP (env fallback) ───────────────────────────────────────────────
# These are used only when no encrypted cloud config exists (Admin → App Config).
# When a cloud config is saved, these env vars are ignored for SMTP.
# Leave all blank to silently skip email sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Delivery Clarity <your-email@gmail.com>

# ── Delivery Intelligence AI (optional) ──────────────────────────────────────
# /intelligence remains fully usable without an AI provider in grounded
# Evidence mode. When this key is set, only a compact delivery-evidence
# snapshot (not the full Jira export) is sent to the specialist AI endpoint.
OPENAI_API_KEY=
# Optional Responses API model override. Terra is the quality/cost-balanced
# default for professional delivery analysis; set gpt-5.6-sol when maximum
# reasoning quality is preferred over latency/cost.
OPENAI_AGENT_MODEL=gpt-5.6-terra
