# Delivery Clarity — environment variables
# Copy to .env for local development, .env.production for production

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of the app — used in email login links and redirects.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Authentication (required) ─────────────────────────────────────────────────
# Session encryption key — must be ≥32 chars, keep secret
SESSION_SECRET=change-this-to-a-random-32-char-secret-value

# Session duration in hours (default: 8)
SESSION_TTL_HOURS=8

# PostgreSQL connection string. Production should use Neon's pooled URL.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/delivery_clarity?sslmode=require

# Allow public self-registration (false = admin creates users only)
ALLOW_OPEN_REGISTRATION=true
NEXT_PUBLIC_ALLOW_REGISTER=true

# First admin account — used by the seed script (prisma/seed.ts)
ADMIN_EMAIL=admin@deliveryclarity.com
ADMIN_PASSWORD="Admin@DC2025"
ADMIN_NAME=Administrator

# ── Encrypted App Config ──────────────────────────────────────────────────────
# AES-256-GCM key for encrypting app-config.json stored in cloud storage.
# Must be ≥32 chars. Generate with: openssl rand -hex 32
# Once set, SMTP and other settings can be managed via Admin Settings → App Config.
CONFIG_ENCRYPTION_KEY=change-this-to-a-random-32-char-key-value

# ── Persistent object storage ─────────────────────────────────────────────────
# Local development may use temporary. Production on Koyeb must use object
# storage because application-local files are ephemeral.
STORAGE_DRIVER=temporary
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_PREFIX=delivery-clarity
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Upload cap for Jira CSV/XLS/XLSX files. Keep small for free/small instances.
MAX_UPLOAD_MB=20

# ── Jira API Integration (ARCH-05 — read-only, env fallback) ──────────────────
# Preferred: set the token via Admin Settings → App Config → "Jira API Token"
# (encrypted into the same app-config.json as SMTP, see CONFIG_ENCRYPTION_KEY
# above). This env var is only a fallback/override for when no cloud config
# exists yet, or to force-rotate a token without touching the cloud copy —
# same pattern as SMTP_* below. Shared by every configured JiraConnection
# (single global credential; the connection's base URL/email/deployment type
# are admin-configured in-app, not env vars). See
# product/JIRA_INTEGRATION_DESIGN.md.
# Cloud: an Atlassian API token (paired with the connection's authEmail).
# Server/Data Center: a Personal Access Token (PAT), used as a Bearer token.
GATEWAY_JIRA_API_TOKEN=

# ── Email / SMTP (env fallback) ───────────────────────────────────────────────
# These are used only when no encrypted cloud config exists (Admin → App Config).
# When a cloud config is saved, these env vars are ignored for SMTP.
# Leave all blank to silently skip email sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Delivery Clarity <your-email@gmail.com>
