datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Multi-Tenant Organization Management (ORG-01–59, Phase 1) ────────────────
// See product/MULTI_TENANT_ORG_DESIGN.md §2.1/§2.2/§9. organizationId is added
// nullable on every listed model first; a backfill script + a second migration
// tightening to non-nullable follow once this migration itself has been
// reviewed and applied — never a single non-nullable-FK-with-no-backfill step.

model Organization {
  id               String    @id @default(cuid())
  name             String
  domain           String    @unique // verified domain, e.g. "ali.com" — lowercase, no scheme
  domainVerifiedAt DateTime? // null until ORG-12 verification completes
  logoUrl          String?
  maxSeats         Int       @default(6) // ORG-10: fixed at ASSIGNABLE_ROLES.length, never admin-editable
  status           String    @default("active") // "active" | "suspended" — ORG-16, non-destructive
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users             User[]
  importLogs        ImportLog[]
  snapshots         DashboardSnapshot[]
  auditEvents       AuditEvent[]
  userAddRequests   UserAddRequest[]
  notifications     Notification[]
  jiraConnections   JiraConnection[]

  @@index([domain])
  @@index([status])
}

model User {
  id                       String    @id @default(cuid())
  organizationId           String  // ORG-04 — tightened to non-nullable, backfill confirmed complete
  name                     String
  email                    String    @unique
  passwordHash             String
  role                     String    @default("user") // "user" | "admin"
  // EP-016: a super-admin is still role: "admin" (same route/nav access) but is protected
  // from being modified or deleted by any other admin — enforced in app/api/admin/users/route.ts.
  isSuperAdmin             Boolean   @default(false)
  // EP-011: public registration fields
  emailVerified            Boolean   @default(false) // true once verification link is clicked (EP-012)
  // EP-012: email verification link — set at registration, cleared once verified.
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  // EP-013: "Forgot your password" — set on request, cleared once used or on successful login.
  passwordResetToken       String?   @unique
  passwordResetExpires     DateTime?
  persona                  String    @default("") // primary professional persona chosen at signup
  secondaryPersonas        String[]  @default([]) // EP-011: zero or more secondary roles, master plan §4.1 — analytics only, no permissions
  // EP-014: consent and legal document acceptance
  termsAcceptedAt          DateTime? // when user accepted the Terms of Use + Privacy Policy
  termsVersion             String    @default("") // document version accepted e.g. "v1"
  avatarUrl                String?
  position                 String?
  phone                    String?
  contactEmail             String?
  address                  String?
  certificates             String?
  bio                      String?
  isActive                 Boolean   @default(true)
  mustChangePassword       Boolean   @default(false)
  // P0B-04: set on self-service account-deletion request — isActive is flipped
  // false in the same write, locking the account out immediately (reuses the
  // existing EP-010 session-ejection check in GET /api/auth/me). A scheduled
  // job hard-deletes the row once this is older than the grace period; an
  // admin reactivating the account (isActive: true) clears this back to null.
  deletionRequestedAt      DateTime?
  // EP-017: per-user privacy choice — "cloud" (default, current behavior) keeps uploaded
  // Jira data + computed metrics server-side; "local" keeps them in the user's own browser
  // only (never uploaded to this server), traded off against no admin visibility, no
  // cross-device sync, and loss on a cleared browser. See app/page.tsx handleFile().
  dataStorageMode          String    @default("cloud") // "cloud" | "local"
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  lastLoginAt              DateTime?

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions             Session[]
  importLogs           ImportLog[]
  snapshots            DashboardSnapshot[]
  auditEvents          AuditEvent[]
  userAddRequests      UserAddRequest[]     @relation("UserAddRequestRequester")
  notifications        Notification[]       @relation("UserNotifications")
  jiraConnections      JiraConnection[]
  ownedWorkspace       Workspace?           @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  entitlement          Entitlement?
  storageProvider      UserStorageProvider?
  issueTypeHierarchy   UserIssueTypeHierarchy?
  consents             Consent[]

  @@index([organizationId])
}

// ── Consent (P0B-03) ────────────────────────────────────────────────────────
// Append-only consent record — one row per grant/withdrawal event, never
// updated in place. Current status for a purpose = the latest row for
// (userId, purpose). Satisfies the privacy policy's "consent records...
// retained" promise (src/lib/legal-i18n/en.ts §6), which the old flat
// User.termsAcceptedAt/termsVersion write-once fields never actually did.

model Consent {
  id        String   @id @default(cuid())
  userId    String
  purpose   String // "terms_and_privacy" | "analytics"
  granted   Boolean
  version   String   @default("") // e.g. CURRENT_TERMS_VERSION for terms_and_privacy; "" for analytics
  source    String // "registration" | "settings"
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

// ── Trial Entitlement (EP-015) ─────────────────────────────────────────────────
// One entitlement per user. Tracks the free-trial lifecycle.
// Status flow: eligible → [processing →] consumed → expired
//              eligible → suspended (admin action)
//              consumed/expired → restored (admin action) → eligible

model Entitlement {
  id          String  @id @default(cuid())
  userId      String  @unique // one entitlement per user
  workspaceId String? // linked to the user's workspace

  // eligible | processing | consumed | expired | suspended | restored
  status String @default("eligible")

  consumedAt  DateTime? // when the first successful analysis completed
  expiresAt   DateTime? // consumedAt + 30 days
  importLogId String? // the ImportLog that consumed the entitlement

  replacementUsedAt DateTime? // EP-015: set when the one 24h-window replacement upload is used

  restoredBy   String? // admin userId who manually restored
  restoredAt   DateTime?
  restoredNote String? // reason for restoration

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  importLog ImportLog? @relation(fields: [importLogId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([expiresAt])
  @@index([userId])
}

// ── Workspace (EP-006 — one workspace per user for MVP) ───────────────────────
// Each registered user owns exactly one Workspace.
// All their analysis data (imports, snapshots, jira connections) is scoped here.
// Schema supports future multi-member workspaces; MVP enforces single-member only.

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  status      String   @default("active") // "active" | "suspended" | "deleted"
  ownerUserId String   @unique // one workspace per user in MVP
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner           User                @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members         WorkspaceMember[]
  importLogs      ImportLog[]
  snapshots       DashboardSnapshot[]
  jiraConnections JiraConnection[]

  @@index([ownerUserId])
  @@index([status])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  accessRole  String   @default("owner") // "owner" | "member" (member for future use)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model UserIssueTypeHierarchy {
  id         String   @id @default(cuid())
  userId     String   @unique
  configJson String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppSetting {
  id        String   @id @default(cuid())
  ownerId   String   @default("global")
  key       String
  valueJson String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, key])
  @@index([key])
  @@index([ownerId])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  sessionTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  userAgent        String?
  ipAddress        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ImportLog {
  id               String   @id @default(cuid())
  organizationId   String  // ORG-04 — tightened to non-nullable, backfill confirmed complete
  userId           String
  // ARCH-05: file-sourced imports populate fileName/fileSize/fileType; API-sourced
  // imports (sourceType: "api") leave them null and populate jiraConnectionId instead.
  sourceType       String   @default("file") // "file" | "api"
  fileName         String?
  fileSize         Int?
  fileType         String?
  jiraConnectionId String?
  rowCount         Int      @default(0)
  status           String // "success" | "partial" | "failed" | "validation_failed"
  warningsCount    Int      @default(0)
  errorsCount      Int      @default(0)
  totalIssues      Int      @default(0)
  doneIssues       Int      @default(0)
  healthScore      Float    @default(0)
  uploadedAt       DateTime @default(now())
  processingTimeMs Int      @default(0)
  metadataJson     String?

  workspaceId String?

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jiraConnection JiraConnection?     @relation(fields: [jiraConnectionId], references: [id], onDelete: SetNull)
  workspace      Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  snapshots      DashboardSnapshot[]
  entitlements   Entitlement[]

  @@index([userId])
  @@index([organizationId])
  @@index([jiraConnectionId])
  @@index([workspaceId])
  @@index([status, uploadedAt]) // fast "last successful import" query
}

model DashboardSnapshot {
  id             String   @id @default(cuid())
  organizationId String  // ORG-04 — tightened to non-nullable, backfill confirmed complete
  userId       String
  importLogId  String?
  workspaceId  String?
  snapshotName String
  metricsJson  String
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  importLog ImportLog? @relation(fields: [importLogId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([workspaceId])
}

model AuditEvent {
  id               String   @id @default(cuid())
  organizationId   String? // ORG-04 — stays permanently nullable, mirroring userId (design doc §2.2)
  userId           String?
  eventType        String // "login" | "logout" | "upload" | "export" | "register"
  eventDescription String
  createdAt        DateTime @default(now())
  ipAddress        String?
  userAgent        String?
  correlationId    String? // P0A-07: per-request ID, set by proxy.ts, threaded through safeAuditEvent()

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([createdAt])
  @@index([eventType, createdAt]) // fast admin filtering by event type
  @@index([correlationId])
}

// ── User Add-Member Request Workflow (USERREQ-07–09) ─────────────────────────

model UserAddRequest {
  id                String    @id @default(cuid())
  organizationId    String  // ORG-04 — tightened to non-nullable, backfill confirmed complete
  requestedName     String
  requestedEmail    String
  requestedRole     String
  reason            String
  teamOrProject     String?
  notes             String?
  // Status: "pending" | "accepted" | "rejected" | "cancelled" | "expired"
  status            String    @default("pending")
  requestedByUserId String
  adminDecisionById String?
  adminDecisionAt   DateTime?
  adminDecisionNote String?
  createdUserId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy User @relation("UserAddRequestRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([requestedByUserId])
  @@index([organizationId])
  @@index([status])
}

model Notification {
  id                String    @id @default(cuid())
  organizationId    String  // ORG-04 — tightened to non-nullable, backfill confirmed complete
  recipientUserId   String
  type              String
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient User @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId])
  @@index([organizationId])
  @@index([readAt])
}

// ── Per-User "Bring Your Own Cloud" Storage (EP-024) ────────────────────────────
// One optional cloud-storage provider per user, for cloud-mode users who want
// their uploads to land in a bucket they own instead of Delivery Clarity's own
// server-side "App storage". Never trusted until a fresh Test Connection
// succeeds — any config change resets `verified` to false.

model UserStorageProvider {
  id             String    @id @default(cuid())
  userId         String    @unique
  provider       String // "s3" | "azure" | "gcp"
  configJson     String // non-secret fields (bucket, region, prefix, endpoint, containerName, projectId) as JSON
  credentialsEnc String? // encryptSecret()'d JSON blob of the secret fields
  verified       Boolean   @default(false)
  verifiedAt     DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Jira API Read-Only Integration (ARCH-05 — see product/JIRA_INTEGRATION_DESIGN.md) ─

model JiraConnection {
  id                     String    @id @default(cuid())
  organizationId         String  // ORG-04 — tightened to non-nullable, backfill confirmed complete
  name                   String // admin-facing label, e.g. "Production Jira"
  deploymentType         String // "cloud" | "server"
  baseUrl                String
  authEmail              String? // Cloud only — paired with this connection's encrypted API token/PAT.
  apiTokenEncrypted      String?
  projectFilters         String // JSON array of project keys
  fieldMapping           String // JSON: { canonicalField: jiraFieldId }
  refreshMode            String    @default("manual") // "manual" | "scheduled"
  refreshIntervalMinutes Int       @default(30)
  lastSyncAt             DateTime?
  lastSyncStatus         String? // "success" | "partial" | "failed"
  lastSyncError          String?
  createdByUserId        String
  workspaceId            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy  User        @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  workspace  Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  importLogs ImportLog[]

  @@index([createdByUserId])
  @@index([organizationId])
  @@index([workspaceId])
}

// ── System Error Log (P-SYSERR) ───────────────────────────────────────────────

model SystemErrorLog {
  id            String    @id @default(cuid())
  errorCode     String // Prisma code (P2003, P2025, …) or "UNKNOWN"
  errorMessage  String
  prismaModel   String? // model that failed, e.g. "AuditEvent"
  operation     String // e.g. "auditEvent.create", "notification.createMany"
  context       String? // route / action that triggered the error
  payload       String? // JSON-serialised data for retry
  resolution    String    @default("logged") // "logged" | "auto-fixed" | "retried" | "resolved" | "skipped"
  retryCount    Int       @default(0)
  lastRetriedAt DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  correlationId String? // P0A-07: per-request ID, populated when carried by the originating call

  @@index([errorCode])
  @@index([createdAt])
  @@index([resolution])
  @@index([correlationId])
}

// ── User feedback (P0B-09) ────────────────────────────────────────────────────
// Captures structured feedback from the floating "Feedback" button on every page.
// Never attaches uploaded Jira data (master plan §4.6 requirement).

model Feedback {
  id            String   @id @default(cuid())
  category      String // Suggestion | Problem/Bug | Feature Request | Complaint | Question | Data/Calculation Concern | Other
  message       String
  impactLevel   String   @default("Minor") // Minor | Affects My Work | Blocks Me
  canContact    Boolean  @default(false)
  page          String? // pathname where feedback was submitted
  appVersion    String?
  browserFamily String?
  status        String   @default("New") // New | Reviewing | Accepted | Planned | In Progress | Released | Rejected
  statusNote    String? // admin note on the current status
  userId        String? // populated if user was logged in
  userEmail     String? // email for contact if canContact = true
  // P0B-09: optional, user-initiated screenshot capture — data:image/jpeg;base64,...
  // Never sent automatically; the user explicitly opts in and previews it before
  // submitting. GET /api/admin/feedback must never select this field in bulk
  // (see app/api/admin/feedback/[id]/screenshot/route.ts for the lazy fetch).
  screenshotData String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([category, createdAt])
}

// ── Client error monitoring (P0B-08) ─────────────────────────────────────────
// Captures client-side crashes and unhandled rejections from the browser.
// Identical errors are de-duplicated by fingerprint (hash of message+page+component).
// Stack traces are sanitised server-side before storage.

model AppError {
  id             String    @id @default(cuid())
  fingerprint    String // sha256(message+page+component) — dedup key
  message        String
  stack          String? // sanitised stack — no absolute paths or PII
  severity       String    @default("error") // "error" | "warning" | "critical"
  page           String? // pathname where the error occurred
  component      String? // React component or handler name
  userId         String? // populated if the user was logged in
  browserFamily  String? // Chrome, Firefox, Safari …
  releaseVersion String? // package.json version at build time
  count          Int       @default(1) // incremented on each occurrence
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionNote String?

  @@index([fingerprint])
  @@index([severity, lastSeenAt])
  @@index([page, lastSeenAt])
  @@index([resolvedAt])
}

// ── Login attempt log (persistent rate limiter — survives cold starts) ────────
// Replaces the in-memory Map in login/route.ts (GAP-1 from P0A-05 audit).
// Rows older than 10 minutes are purged on each login attempt so the table
// stays small even under sustained traffic.

model LoginAttempt {
  id          String   @id @default(cuid())
  ip          String
  attemptedAt DateTime @default(now())

  @@index([ip, attemptedAt])
}

// ── SMTP Settings (per-deployment; future: per-organisation) ──────────────────
// Password is stored AES-256-GCM encrypted via secret-field.ts.
// Priority chain at runtime: this table → cloud S3 config → SMTP_* env vars.

model SmtpSettings {
  id              String   @id @default(cuid())
  host            String
  port            Int      @default(587)
  username        String
  passEncrypted   String
  fromAddress     String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}
