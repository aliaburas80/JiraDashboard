datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               String    @default("user") // "user" | "admin"
  avatarUrl          String?
  position           String?
  phone              String?
  contactEmail       String?
  address            String?
  certificates       String?
  bio                String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastLoginAt        DateTime?

  sessions        Session[]
  importLogs      ImportLog[]
  snapshots       DashboardSnapshot[]
  auditEvents     AuditEvent[]
  userAddRequests UserAddRequest[]    @relation("UserAddRequestRequester")
  notifications   Notification[]      @relation("UserNotifications")
  jiraConnections JiraConnection[]
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  sessionTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  userAgent        String?
  ipAddress        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ImportLog {
  id               String   @id @default(cuid())
  userId           String
  // ARCH-05: file-sourced imports populate fileName/fileSize/fileType; API-sourced
  // imports (sourceType: "api") leave them null and populate jiraConnectionId instead.
  sourceType       String   @default("file") // "file" | "api"
  fileName         String?
  fileSize         Int?
  fileType         String?
  jiraConnectionId String?
  rowCount         Int      @default(0)
  status           String // "success" | "partial" | "failed" | "validation_failed"
  warningsCount    Int      @default(0)
  errorsCount      Int      @default(0)
  totalIssues      Int      @default(0)
  doneIssues       Int      @default(0)
  healthScore      Float    @default(0)
  uploadedAt       DateTime @default(now())
  processingTimeMs Int      @default(0)
  metadataJson     String?

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jiraConnection JiraConnection?     @relation(fields: [jiraConnectionId], references: [id], onDelete: SetNull)
  snapshots      DashboardSnapshot[]

  @@index([userId])
  @@index([jiraConnectionId])
  @@index([status, uploadedAt])  // fast "last successful import" query
}

model DashboardSnapshot {
  id           String   @id @default(cuid())
  userId       String
  importLogId  String?
  snapshotName String
  metricsJson  String
  createdAt    DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  importLog ImportLog? @relation(fields: [importLogId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model AuditEvent {
  id               String   @id @default(cuid())
  userId           String?
  eventType        String // "login" | "logout" | "upload" | "export" | "register"
  eventDescription String
  createdAt        DateTime @default(now())
  ipAddress        String?
  userAgent        String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([eventType, createdAt])  // fast admin filtering by event type
}

// ── User Add-Member Request Workflow (USERREQ-07–09) ─────────────────────────

model UserAddRequest {
  id                String    @id @default(cuid())
  requestedName     String
  requestedEmail    String
  requestedRole     String
  reason            String
  teamOrProject     String?
  notes             String?
  // Status: "pending" | "accepted" | "rejected" | "cancelled" | "expired"
  status            String    @default("pending")
  requestedByUserId String
  adminDecisionById String?
  adminDecisionAt   DateTime?
  adminDecisionNote String?
  createdUserId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  requestedBy User @relation("UserAddRequestRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([requestedByUserId])
  @@index([status])
}

model Notification {
  id                String    @id @default(cuid())
  recipientUserId   String
  type              String
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime  @default(now())

  recipient User @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId])
  @@index([readAt])
}

// ── Jira API Read-Only Integration (ARCH-05 — see product/JIRA_INTEGRATION_DESIGN.md) ─

model JiraConnection {
  id                     String    @id @default(cuid())
  name                   String // admin-facing label, e.g. "Production Jira"
  deploymentType         String // "cloud" | "server"
  baseUrl                String
  authEmail              String? // Cloud only — paired with this connection's encrypted API token/PAT.
  apiTokenEncrypted      String?
  projectFilters         String // JSON array of project keys
  fieldMapping           String // JSON: { canonicalField: jiraFieldId }
  refreshMode            String    @default("manual") // "manual" | "scheduled"
  refreshIntervalMinutes Int       @default(30)
  lastSyncAt             DateTime?
  lastSyncStatus         String? // "success" | "partial" | "failed"
  lastSyncError          String?
  createdByUserId        String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  createdBy  User        @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  importLogs ImportLog[]

  @@index([createdByUserId])
}

// ── System Error Log (P-SYSERR) ───────────────────────────────────────────────

model SystemErrorLog {
  id            String    @id @default(cuid())
  errorCode     String // Prisma code (P2003, P2025, …) or "UNKNOWN"
  errorMessage  String
  prismaModel   String? // model that failed, e.g. "AuditEvent"
  operation     String // e.g. "auditEvent.create", "notification.createMany"
  context       String? // route / action that triggered the error
  payload       String? // JSON-serialised data for retry
  resolution    String    @default("logged") // "logged" | "auto-fixed" | "retried" | "resolved" | "skipped"
  retryCount    Int       @default(0)
  lastRetriedAt DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([errorCode])
  @@index([createdAt])
  @@index([resolution])
}

// ── User feedback (P0B-09) ────────────────────────────────────────────────────
// Captures structured feedback from the floating "Feedback" button on every page.
// Never attaches uploaded Jira data (master plan §4.6 requirement).

model Feedback {
  id            String    @id @default(cuid())
  category      String    // Suggestion | Problem/Bug | Feature Request | Complaint | Question | Data/Calculation Concern | Other
  message       String
  impactLevel   String    @default("Minor") // Minor | Affects My Work | Blocks Me
  canContact    Boolean   @default(false)
  page          String?   // pathname where feedback was submitted
  appVersion    String?
  browserFamily String?
  status        String    @default("New") // New | Reviewing | Accepted | Planned | In Progress | Released | Rejected
  statusNote    String?   // admin note on the current status
  userId        String?   // populated if user was logged in
  userEmail     String?   // email for contact if canContact = true
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([category, createdAt])
}

// ── Client error monitoring (P0B-08) ─────────────────────────────────────────
// Captures client-side crashes and unhandled rejections from the browser.
// Identical errors are de-duplicated by fingerprint (hash of message+page+component).
// Stack traces are sanitised server-side before storage.

model AppError {
  id              String    @id @default(cuid())
  fingerprint     String    // sha256(message+page+component) — dedup key
  message         String
  stack           String?   // sanitised stack — no absolute paths or PII
  severity        String    @default("error") // "error" | "warning" | "critical"
  page            String?   // pathname where the error occurred
  component       String?   // React component or handler name
  userId          String?   // populated if the user was logged in
  browserFamily   String?   // Chrome, Firefox, Safari …
  releaseVersion  String?   // package.json version at build time
  count           Int       @default(1)      // incremented on each occurrence
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  resolvedAt      DateTime?
  resolutionNote  String?

  @@index([fingerprint])
  @@index([severity, lastSeenAt])
  @@index([page, lastSeenAt])
  @@index([resolvedAt])
}

// ── Login attempt log (persistent rate limiter — survives cold starts) ────────
// Replaces the in-memory Map in login/route.ts (GAP-1 from P0A-05 audit).
// Rows older than 10 minutes are purged on each login attempt so the table
// stays small even under sustained traffic.

model LoginAttempt {
  id          String   @id @default(cuid())
  ip          String
  attemptedAt DateTime @default(now())

  @@index([ip, attemptedAt])
}

// ── SMTP Settings (per-deployment; future: per-organisation) ──────────────────
// Password is stored AES-256-GCM encrypted via secret-field.ts.
// Priority chain at runtime: this table → cloud S3 config → SMTP_* env vars.

model SmtpSettings {
  id             String   @id @default(cuid())
  host           String
  port           Int      @default(587)
  username       String
  passEncrypted  String
  fromAddress    String
  updatedByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([updatedAt])
}
